# ===== MiscalorIAs .gitignore =====
# Solo se sube a GitHub Pages lo necesario para la app en produccion.

# Basura de sistema operativo / editores
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Dependencias (si se agregan despues)
node_modules/

# Tooling local / venv (no necesario en Pages)
tools/

# Config local sensible
.env
.env.local

# Capturas y archivos de prueba de desarrollo
screenshots/
test-*.js
test-*.jpg
test-*.png
find-404.js
smoke-test.js
local-server.js
package.json
package-lock.json
favicon.jpg
